extends layout

block content
  h1= data.firstName + ' ' + data.lastName
  p
    if data !== undefined
        ul
              li='---------------------------------'
              li='Firstname: ' + data.firstName
              li='LastName: ' + data.lastName
              li='Date of Birth: ' + data.dateOfBirthFormatted()
              li='Age: ' + data.getAge()
              li=data.haveTheyWhackedAnybody()
              li=data.areTheyDead()
              li='Family: ' + data.family
              li='Location: ' + data.location
              li='---------------------------------'
    else
        p='Could not find user.'

