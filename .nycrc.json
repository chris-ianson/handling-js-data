{
  "all": true,
  "cache": true,
  "check-coverage": true,
  "lines": 100,
  "statements": 100,
  "functions": 100,
  "branches": 100,
  "report-dir": "coverage",
  "reporter": [
    "text",
    "html"
  ],
  "include": [
    "routes/**/*.ts",
    "models/**/*.ts",
    "services/**/*.ts",
    "connectors/**/*.ts"
  ],
  "exclude": [
    "coverage/*",
    "test/*",
    "build"
  ]
}
