{
  "name": "handling-js-data",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "DEBUG=handling-js-data:* nodemon server.ts",
    "dev:ts": "DEBUG=handling-js-data:* nodemon -x 'node --inspect -r ts-node/register' ./bin/www",
    "test": "mocha -r ts-node/register test --config ./test/.mocharc.js --exit",
    "test:jest": "jest --collectCoverage --coverageDirectory=jest-coverage --detectOpenHandles",
    "test:coverage": "c8 --all --reporter=html --reporter=text npm run test"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "class-transformer": "^0.5.1",
    "cookie-parser": "~1.4.4",
    "dayjs": "^1.10.6",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "morgan": "~1.9.1",
    "reflect-metadata": "^0.1.13",
    "ts-node": "^10.4.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.12",
    "@types/mocha": "^10.0.1",
    "@types/sinon": "^17.0.3",
    "c8": "^9.1.0",
    "chai": "^4.3.7",
    "jest": "^29.7.0",
    "mocha": "^10.2.0",
    "nodemon": "^2.0.15",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "typescript": "^4.9.5"
  }
}
