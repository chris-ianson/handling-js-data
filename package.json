{
  "name": "handling-js-data",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "copy-templates": "copyfiles -u 1 src/views/*.pug dist/src/",
    "copy-css": "copyfiles -u 1 public/stylesheets/*.css dist/public",
    "build": "npx tsc && npm run copy-templates && npm run copy-css",
    "start": "node dist/server.js",
    "dev": "DEBUG=handling-js-data:* nodemon server.ts",
    "test": "mocha -r ts-node/register test --config ./test/.mocharc.js --exit",
    "test:jest": "jest --collectCoverage --coverageDirectory=jest-coverage --detectOpenHandles",
    "test:coverage": "c8 --all --reporter=html --reporter=text npm run test"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "class-transformer": "^0.5.1",
    "cookie-parser": "~1.4.4",
    "dayjs": "^1.10.6",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "~4.19.2",
    "helmet": "^7.1.0",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "pug": "^3.0.2",
    "reflect-metadata": "^0.1.13",
    "ts-node": "^10.4.0",
    "winston": "^3.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@types/chai": "^4.3.4",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.12",
    "@types/sinon": "^17.0.3",
    "c8": "^9.1.0",
    "chai": "^4.3.7",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "fast-check": "^3.16.0",
    "jest": "^29.7.0",
    "jest-mock-axios": "^4.7.3",
    "lefthook": "^1.6.8",
    "mocha": "^10.2.0",
    "node-notifier": "^10.0.1",
    "nodemon": "^3.1.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "typescript": "^4.9.5",
    "typescript-eslint": "^7.5.0"
  }
}
